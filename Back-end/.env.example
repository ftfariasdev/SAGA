# Copie este arquivo para `.env` e ajuste o que precisar:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows / cmd)
#
# O arquivo `.env` NAO vai para o Git (esta no .gitignore).

# ---------------------------------------------------------------------------
# Banco de dados (container Postgres definido em docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=saga
POSTGRES_PASSWORD=saga
POSTGRES_DB=saga

# Porta exposta na SUA maquina. Troque para 5433 se voce ja tiver um Postgres
# local ocupando a 5432 (lembre de trocar tambem na DATABASE_URL abaixo).
POSTGRES_PORT=5432

# Usada pelo Prisma. Precisa bater com as variaveis acima.
# Formato: postgresql://USUARIO:SENHA@localhost:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://saga:saga@localhost:5432/saga?schema=public"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000

# Segredo para assinar os tokens JWT. Gere um valor proprio, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio

# ---------------------------------------------------------------------------
# Login com Google (opcional)
# ---------------------------------------------------------------------------
# Sem esta variavel o login por email/senha funciona normalmente; apenas o
# botao "Entrar com Google" fica indisponivel.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Bcrypt (opcional)
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=10